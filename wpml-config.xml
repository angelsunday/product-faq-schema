<?xml version="1.0" encoding="UTF-8"?>
<!--
  Ρυθμίσεις WPML για το Product FAQ Schema.
  Το WPML διαβάζει αυτό το αρχείο από τον φάκελο του plugin.
-->
<wpml-config>
  <custom-fields>
    <!-- Οι χειροκίνητες FAQs: μεταφράζονται ξεχωριστά για κάθε γλώσσα -->
    <custom-field action="translate">_pfs_custom_faqs</custom-field>
    <!-- Η απενεργοποίηση του schema ανά προϊόν: αντιγράφεται σε όλες τις μεταφράσεις -->
    <custom-field action="copy">_pfs_disable</custom-field>
  </custom-fields>

  <!--
    Οι FAQs αποθηκεύονται ως λίστα από ζεύγη [ 'q' => ερώτηση, 'a' => απάντηση ].
    Το "*" αντιστοιχεί σε κάθε στοιχείο της λίστας και τα q / a είναι τα πεδία που μεταφράζονται.
  -->
  <custom-fields-texts>
    <key name="_pfs_custom_faqs">
      <key name="*">
        <key name="q" />
        <key name="a" />
      </key>
    </key>
  </custom-fields-texts>
</wpml-config>
